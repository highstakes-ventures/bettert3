{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "nodeBuiltinImport": "off",
          "globalDate": "off",
          "globalDateInEffect": "off",
          "globalFetch": "off",
          "globalFetchInEffect": "off",
          "schemaSyncInEffect": "off"
        }
      }
    ]
  },
  "include": ["src"]
}
